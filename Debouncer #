`timescale 1ns / 1ps


module debouncer #(
    parameter integer COUNT_MAX = 2000000
)(
    input wire clk,
    input wire reset,
    input wire noisy,
    output reg clean
);

    reg sync0 = 0;
    reg sync1 = 0;
    reg [61:0] count = 0;

    always @(posedge clk) begin
        if (reset) begin
            sync0 <= 0;
            sync1 <= 0;
            count <= 0;
            clean <= 0;
        end
        else begin
            // Synchronize the button input
            sync0 <= noisy;
            sync1 <= sync0;

            if (sync1 == clean) begin
                count <= 0;
            end
            else if (count >= COUNT_MAX - 1) begin
                clean <= sync1;
                count <= 0;
            end
            else begin
                count <= count + 1;
            end
        end
    end

endmodule


