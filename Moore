`timescale 1ns / 1ps


module tb_moore_1100;

    reg clk;
    reg reset;
    reg x;
    wire detected;

    moore_1100 uut (
        .clk(clk),
        .reset(reset),
        .x(x),
        .detected(detected)
    );

    // Clock period = 10 ns
    always #5 clk = ~clk;

    initial begin
        clk = 0;
        reset = 1;
        x = 0;

        #20;
        reset = 0;

        // Test sequence: 1100
        @(negedge clk); x = 1;
        @(negedge clk); x = 1;
        @(negedge clk); x = 0;
        @(negedge clk); x = 0;

        // Test additional bits
        @(negedge clk); x = 1;
        @(negedge clk); x = 1;
        @(negedge clk); x = 0;
        @(negedge clk); x = 0;

        @(negedge clk);
        $finish;
    end

endmodule


